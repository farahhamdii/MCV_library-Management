@model MVC_Task.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0">📖 Book Details</h3>
                </div>

                <div class="card-body">

                    <div class="row mb-4">

                        <div class="col-md-6">
                            <h5 class="text-secondary">Title</h5>
                            <p class="fs-5">@Model.Title</p>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-secondary">Author</h5>
                            <p class="fs-5">@Model.Author.Name</p>
                        </div>

                    </div>

                    <div class="row mb-4">

                        <div class="col-md-6">
                            <h5 class="text-secondary">Category</h5>
                            <p class="fs-5">@Model.Category</p>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-secondary">Publication Date</h5>
                            <p class="fs-5">
                                @Model.publicationDate.ToShortDateString()
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <a asp-action="GetAll"
                           class="btn btn-secondary">
                            ← Back
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>