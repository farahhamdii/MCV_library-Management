@model MVC_Task.Models.Author

@{
    ViewData["Title"] = "Add Author";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow border-0">

                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0">📚 Add New Author</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Add" method="post">

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>

                            <input asp-for="Name" class="form-control" placeholder="Enter Author Name" />

                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label"></label>

                            <textarea asp-for="Bio"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Write Author Biography"></textarea>

                            <span asp-validation-for="Bio" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DateOfBirth" class="form-label"></label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">

                            <a asp-action="GetAll" class="btn btn-secondary">
                                Back
                            </a>

                            <button type="submit" class="btn btn-success">
                                Save Author
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}