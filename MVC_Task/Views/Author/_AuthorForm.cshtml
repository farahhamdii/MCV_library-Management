@model MVC_Task.ViewModels.AuthorEditVm

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>

    <input asp-for="Name" class="form-control" placeholder="Enter Author Name" />

    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Bio" class="form-label"></label>

    <textarea asp-for="Bio"
              class="form-control"
              rows="4"
              placeholder="Write Author Biography"></textarea>

    <span asp-validation-for="Bio" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="DateOfBirth" class="form-label"></label>

    <input asp-for="DateOfBirth"
           type="date"
           class="form-control" />

    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
</div>

<div class="d-flex justify-content-between">

    <a asp-action="GetAll" class="btn btn-secondary">
        Back
    </a>

    <button type="submit" class="btn btn-success">
        Save Author
    </button>

</div>